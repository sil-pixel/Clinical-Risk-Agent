# Copy to .env for local development. Never commit a real key.
# Supported providers: openai, anthropic, gemini
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
# Independent judge model using the same provider and key; change for non-Gemini providers.
LLM_JUDGE_MODEL=gemini-3.5-flash
# semantic (default): exact rules, then the pinned embedding router; rules: rules only
INTENT_ROUTER=semantic

# Generate a random value of at least 32 bytes for shared environments.
SESSION_SIGNING_KEY=
ALLOWED_ORIGINS=http://localhost:5173
# Keep 5 in deployment. A higher value may be supplied only for repeated local reload testing.
SESSION_CREATIONS_PER_NETWORK_HOUR=5
